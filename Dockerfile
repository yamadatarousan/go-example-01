# ============================================================================
# 本番用 Dockerfile（マルチステージビルド）
# ============================================================================
# このDockerfileは「マルチステージビルド」という手法を使っています。
#
# マルチステージビルドとは？
#   - 複数のFROM命令を使い、ビルド用と実行用のイメージを分離する手法
#   - ビルドに必要なツール（コンパイラなど）を最終イメージに含めない
#   - 結果として、非常に小さな本番用イメージが作成できる
#
# このDockerfileの構成:
#   1. ビルドステージ (builder): Go環境でアプリをコンパイル
#   2. 実行ステージ: 最小限のAlpineイメージにバイナリだけをコピー
#
# イメージサイズの比較:
#   - golang:1.24-alpine: 約300MB（ビルドツール込み）
#   - 最終イメージ: 約15MB（バイナリのみ）
# ============================================================================

# ============================================================================
# ステージ1: ビルドステージ
# ============================================================================
# Goのコンパイル環境を使ってアプリケーションをビルドします。
# このステージは最終イメージには含まれません。
FROM golang:1.24-alpine AS builder

# 作業ディレクトリを設定
# 以降のコマンドはこのディレクトリ内で実行される
WORKDIR /app

# 依存関係ファイルを先にコピー
# go.mod と go.sum を先にコピーすることで、Dockerのレイヤーキャッシュを活用
# ソースコードが変更されても、依存関係が変わらなければ再ダウンロードをスキップできる
COPY go.mod go.sum ./

# 依存パッケージのダウンロード
# go mod download は go.mod に記載された依存関係をダウンロードする
RUN go mod download

# ソースコード全体をコピー
COPY . .

# アプリケーションのビルド
# CGO_ENABLED=0: Cライブラリを使わない純粋なGoバイナリを生成
#                これにより、glibcのないAlpineでも動作する
# GOOS=linux:    Linux用のバイナリを生成
# -ldflags="-s -w": デバッグ情報を削除してバイナリサイズを削減
#   -s: シンボルテーブルを削除
#   -w: DWARFデバッグ情報を削除
# -o /api:       出力先を /api に指定
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /api ./cmd/api

# ============================================================================
# ステージ2: 実行ステージ
# ============================================================================
# 最小限のAlpineイメージを使用して、本番用の軽量イメージを作成します。
# ビルドステージで作成したバイナリのみをコピーします。
FROM alpine:3.19

# 必要な最小限のパッケージをインストール
# ca-certificates: HTTPS通信に必要なルート証明書
#                  外部APIやHTTPSサイトにアクセスする場合に必要
# tzdata:          タイムゾーン情報（日本時間などを正しく扱うため）
# --no-cache:      パッケージインデックスをキャッシュしない（イメージサイズ削減）
RUN apk --no-cache add ca-certificates tzdata

# 作業ディレクトリを設定
WORKDIR /app

# ビルドステージからバイナリをコピー
# --from=builder: builderステージから指定ファイルをコピー
# これがマルチステージビルドの核心部分
COPY --from=builder /api .

# マイグレーションファイルをコピー
# 本番環境でマイグレーションを実行する場合に必要
# コンテナ起動時に migrate コマンドで使用する
COPY db/migrations ./db/migrations

# コンテナがリッスンするポートを宣言
# 実際のポート公開は docker run -p で行う
# これはドキュメント的な役割も果たす
EXPOSE 8080

# セキュリティ: 非rootユーザーで実行
# nobody:nobody は最小権限のユーザー
# 万が一アプリに脆弱性があっても、被害を最小限に抑えられる
USER nobody:nobody

# コンテナ起動時に実行するコマンド
# ENTRYPOINT: コンテナのメインプロセスを指定
# CMD との違い: ENTRYPOINTは上書きされにくい
# 配列形式（exec form）を使用することで、シグナルが正しくプロセスに届く
ENTRYPOINT ["/app/api"]
