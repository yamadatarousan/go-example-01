# ============================================================================
# .gitignore - Gitで追跡しないファイルを指定
# ============================================================================

# ビルド成果物
bin/

# テスト関連
*.test
coverage.out

# 環境設定ファイル（機密情報を含む可能性があるため）
.env
.env.local
.env.*.local

# IDE/エディタ設定
.idea/
.vscode/
*.swp
*.swo
*~

# OS生成ファイル
.DS_Store
Thumbs.db

# 依存関係（通常はgo.modで管理するため不要）
vendor/

# ログファイル
*.log

# Playwright
.last-run.json
test-results/
playwright-report/
